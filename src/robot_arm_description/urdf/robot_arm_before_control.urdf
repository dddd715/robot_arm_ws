<?xml version="1.0"?>
<robot name="robot_arm">

  <!-- 底座 -->
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.06"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.50"/>
      <inertia ixx="0.0006" ixy="0" ixz="0"
               iyy="0.0006" iyz="0" izz="0.0009"/>
    </inertial>

  </link>

  <!-- 大臂 -->
  <link name="link1">

    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.15"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.000234" ixy="0" ixz="0"
               iyy="0.000234" iyz="0" izz="0.000018"/>
    </inertial>

  </link>

  <!-- 小臂 -->
  <link name="link2">

    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.15"/>
      </geometry>
      <material name="yellow">
        <color rgba="1 0.8 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00015417" ixy="0" ixz="0"
               iyy="0.00015417" iyz="0" izz="0.00000833"/>
    </inertial>

  </link>

  <!-- 末端执行器 -->
  <link name="gripper">

    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.06"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.04 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002167" ixy="0" ixz="0"
               iyy="0.00003000" iyz="0" izz="0.00002167"/>
    </inertial>

  </link>

  <!-- J1：底座水平旋转 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="10" velocity="1"/>
  </joint>

  <!-- J2：肩关节俯仰 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>

  <!-- J3：肘关节俯仰 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="gripper"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"
           effort="10" velocity="1"/>
  </joint>

</robot>
